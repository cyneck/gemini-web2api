{
  "manifest_version": 3,
  "name": "Gemini Cookie Sync",
  "version": "1.1",
  "description": "Syncs Gemini cookies plus XSRF/build metadata straight into a local gemini-web2api server.",
  "permissions": [
    "cookies",
    "downloads",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://google.com/*",
    "https://*.google.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "action": {
    "default_title": "Gemini Cookie Sync",
    "default_popup": "popup.html"
  }
}
